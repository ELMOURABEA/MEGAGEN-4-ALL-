# MeGaOcToOoN GitHub App Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real values to version control!

# ==============================================================================
# APP_ID: The numeric App ID shown on your GitHub App settings page
# Find it at: https://github.com/settings/apps/megaoctooon
# ==============================================================================
APP_ID=

# ==============================================================================
# PRIVATE_KEY: The full PEM private key you download from GitHub when creating the App.
#
# Option A (recommended for local development): Store the PEM in a separate file
# and reference it, OR paste the multi-line PEM directly:
#
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIEoAIBAAKCAQEA...
# -----END RSA PRIVATE KEY-----"
#
# Option B: Single-line with literal \n sequences (the script converts them):
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEoAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
#
# SECURITY WARNING:
# - Download the private key from GitHub App settings
# - Store it securely (use GitHub Secrets for CI/CD)
# - NEVER share or commit your private key
# ==============================================================================
PRIVATE_KEY=

# ==============================================================================
# INSTALLATION_ID (Optional): Specific installation ID to create a token for.
# Leave blank to auto-select the first available installation.
# The script will list all installations if you run it without an INSTALLATION_ID.
# ==============================================================================
INSTALLATION_ID=
