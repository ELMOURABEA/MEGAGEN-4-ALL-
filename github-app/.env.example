# MeGaOcToOoN GitHub App - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your real .env file with secrets!

# ======================================
# GitHub App Credentials (Required)
# ======================================

# App ID: The numeric App ID shown on your GitHub App settings page
# Find it at: https://github.com/settings/apps/megaoctooon
APP_ID=YOUR_APP_ID_HERE

# Private Key: The full PEM private key downloaded from GitHub
# Download from: https://github.com/settings/apps/megaoctooon -> Private keys -> Generate a private key
#
# Option A (recommended): Multi-line PEM format
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIEoAIBAAKCAQEA...
# -----END RSA PRIVATE KEY-----"
#
# Option B: Single-line with literal \n sequences
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEoAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"

# ======================================
# Optional Configuration
# ======================================

# Installation ID: Leave empty to auto-select first installation
# The script will list all installations if not set
INSTALLATION_ID=

# Webhook Secret: Optional secret for validating webhook payloads
# WEBHOOK_SECRET=your_webhook_secret_here

# ======================================
# Security Notes
# ======================================
# 1. Never commit this file to version control
# 2. Use GitHub Secrets for CI/CD pipelines
# 3. Rotate private keys regularly
# 4. Keep this file with restricted permissions (chmod 600)
