# MEGA-Bot Environment Variables
# Copy this file to .env and fill in your API keys

# GitHub Copilot API Key
COPILOT_API_KEY=your-copilot-api-key-here

# Google Gemini 2.5 Pro API Key
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI ChatGPT 5 API Key
CHATGPT_API_KEY=your-chatgpt-api-key-here

# X.AI Grok 4 Super API Key
GROK_API_KEY=your-grok-api-key-here

# Configuration file path (optional)
MEGABOT_CONFIG=config.json
