# MEGA-Bot Environment Variables
# Copy this file to .env and fill in your API keys

# Debug Mode (set to true for development)
DEBUG=false

# GitHub Copilot API Key
COPILOT_API_KEY=your-copilot-api-key-here

# Google Gemini 2.5 Pro API Key
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI ChatGPT 5 API Key
CHATGPT_API_KEY=your-chatgpt-api-key-here

# X.AI Grok 4 Super API Key
GROK_API_KEY=your-grok-api-key-here

# Google AdMob IDs for advertising (optional)
ADMOB_APP_ID=your-admob-app-id-here
ADMOB_BANNER_ID=your-admob-banner-id-here
ADMOB_INTERSTITIAL_ID=your-admob-interstitial-id-here
ADMOB_REWARDED_ID=your-admob-rewarded-id-here

# Payment Processing Configuration
# Stripe
STRIPE_API_KEY=your-stripe-api-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Cryptocurrency Wallets
BITCOIN_ADDRESS=your-bitcoin-wallet-address-here
DOGECOIN_ADDRESS=your-dogecoin-wallet-address-here

# Bank Transfer Details (JSON format)
BANK_ACCOUNT_NUMBER=your-bank-account-number
BANK_ROUTING_NUMBER=your-bank-routing-number
BANK_ACCOUNT_NAME=MEGAGENT LLC
BANK_NAME=Your Bank Name

# Subscription Tier (free, pro, enterprise)
SUBSCRIPTION_TIER=free

# Configuration file path (optional)
MEGABOT_CONFIG=config.json
